  "ai::hi::Edit item": "आइटम संपादित करें",
  "ai::hi::Save": "बचाना",
  "ai::hi::Estimated shelf life (days)": "अनुमानित शेल्फ जीवन (दिन)",
  "ai::hi::Some items merged with existing records": "कुछ आइटम मौजूदा रिकॉर्ड के साथ विलय हो गए",
  "ai::hi::Could not save to cloud": "क्लाउड में सहेजा नहीं जा सका",
