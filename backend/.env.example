# Server
PORT=3000
NODE_ENV=development

# Home Connect developer portal: https://developer.home-connect.com
# Use simulator for free testing: https://simulator.home-connect.com
BOSCH_API_HOST=https://simulator.home-connect.com

BOSCH_CLIENT_ID=your_client_id
BOSCH_CLIENT_SECRET=your_client_secret

# Must match the Redirect URI registered in the developer portal exactly.
BOSCH_REDIRECT_URI=http://localhost:3000/bosch/callback

# Must match scopes enabled in the developer portal scope matrix.
# Monitor = appliance list/status; camera /images needs FridgeFreezer-Images (partner scope for many apps).
# BOSCH_OAUTH_SCOPE=IdentifyAppliance FridgeFreezer-Monitor FridgeFreezer-Images
BOSCH_OAUTH_SCOPE=IdentifyAppliance FridgeFreezer-Monitor
