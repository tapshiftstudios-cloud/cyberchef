  "ai::ar::Some items merged with existing records": "تم دمج بعض العناصر مع السجلات الموجودة",
  "ai::ar::Could not save to cloud": "تعذر الحفظ في السحابة",
  "ai::ar::Items synced to cloud": "العناصر التي تمت مزامنتها مع السحابة",
  "ai::ar::Sync freshness data": "مزامنة بيانات الحداثة",
