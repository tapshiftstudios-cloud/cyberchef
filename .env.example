# Local development (optional direct Gemini — debug only, no AI_PROXY_REQUIRED)
# GEMINI_API_KEY=your_gemini_api_key_here

# Supabase (required)
SUPABASE_URL=https://your-project.supabase.co
# Legacy JWT anon key or new publishable key (sb_publishable_...) — both work here
SUPABASE_ANON_KEY=your_supabase_publishable_or_anon_key_here

# Production-style AI: proxy only — GEMINI_API_KEY lives in Supabase secrets, not here.
AI_BACKEND_PROXY_URL=https://your-project.supabase.co/functions/v1/ai-proxy
AI_PROXY_REQUIRED=true

# AdMob (https://admob.google.com — uygulama + banner + rewarded birimleri oluştur)
# ADMOB_APP_ID=ca-app-pub-XXXXXXXXXXXXXXXX~YYYYYYYYYY
# ADMOB_BANNER_UNIT_ID=ca-app-pub-XXXXXXXXXXXXXXXX/ZZZZZZZZZZ
# ADMOB_REWARDED_UNIT_ID=ca-app-pub-XXXXXXXXXXXXXXXX/WWWWWWWWWW
# ADS_ENABLED=true

# Optional: better recipe cover photos (https://www.pexels.com/api/)
# PEXELS_API_KEY=your_pexels_api_key

# Smart home (beta) — optional; omit for Play release (settings section hidden).
# Run Node backend: see backend/README.md
# Android emulator → http://10.0.2.2:3000 | phone on Wi‑Fi → http://192.168.x.x:3000
# BOSCH_BACKEND_URL=http://10.0.2.2:3000
# BOSCH_API_HOST=https://simulator.home-connect.com

# Play Console gizlilik politikasi URL (public)
# PRIVACY_POLICY_URL=https://sites.google.com/view/cyberchefprivacy/ana-sayfa

# Play Console Pro subscriptions (must match Play product IDs exactly)
# IAP_PRO_MONTHLY_ID=com.cyberchef.pantry.pro.monthly
# IAP_PRO_YEARLY_ID=com.cyberchef.pantry.pro.yearly

# Opsiyonel: Sentry crash raporlama (https://sentry.io — proje DSN)
# SENTRY_DSN=https://examplePublicKey@o0.ingest.sentry.io/0
